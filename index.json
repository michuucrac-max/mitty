// 💌 Menciones y DM
client.on('messageCreate', async (msg) => {
  if (msg.author.bot) return;
  if (msg.mentions.has(client.user)) {
    const respuesta = frasesBase[Math.floor(Math.random() * frasesBase.length)];
    await msg.reply(respuesta);
    const id = msg.author.id;
    if (!saludados.has(id)) {
      saludados.add(id);
      try {
        await msg.author.send(`💞 ¡Hola ${msg.author.username}! Soy **Softti Tales**, tu zorrita kawaii~ 🦊\n\nAquí tienes mis comandos:\n💬 /softtihabla\n🤗 /softtihug\n💋 /softtikiss\n🐾 /softtipat\n🐱 /softtipet\n💰 /softtimymoney`);
      } catch { }
    }
  }
});

// 🎯 Slash Commands (también con frases aleatorias)
client.on('interactionCreate', async (i) => {
  if (!i.isChatInputCommand()) return;
  const name = i.commandName;
  const user = i.user.username;
  const pool = frasesBase.filter(() => Math.random() > 0.5);
  const frase = pool[Math.floor(Math.random() * pool.length)] || frasesBase[0];
  await i.reply(`💬 ${user}, ${frase}`);
});

